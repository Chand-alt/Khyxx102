{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "style.css",
          "java.js",
          "store/**",
          "Our story/**",
          "clients feedback/**",
          "celebration-loop.mp4/**",
          "guides/**",
          "data/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
